# 环境变量模板
# setup.sh 会把它部署为 ~/.pi-agent-env（已存在则跳过）。
# 在 ~/.zshrc 里加一行 source ~/.pi-agent-env，pi 启动时才能解析
# config/pi/mcp.private.json 里的 ${VAR}。

# ---- 私有 MCP 服务器 (gitlab / atlassian / figma) ----
GITLAB_READ_TOKEN=YOUR_GITLAB_READ_TOKEN
CONFLUENCE_READ_TOKEN=YOUR_CONFLUENCE_READ_TOKEN
JIRA_READ_TOKEN=YOUR_JIRA_READ_TOKEN
FIGMA_API_KEY=YOUR_FIGMA_API_KEY

# ---- Pi 模型认证 (按需，通常写在 pi 的 auth.json 里而不是这里) ----
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
