{
  "mcpServers": {
    "_comment": "含密钥的 MCP 服务器模板。复制为 mcp.private.json，把 YOUR_*_HOST 换成真实地址，token 保持 ${VAR} 形式（由环境变量注入），然后重跑 setup.sh。mcp.private.json 已被 .gitignore 忽略。",
    "gitlab": {
      "type": "http",
      "url": "https://YOUR_GITLAB_MCP_HOST/mcp/",
      "headers": {
        "gitlab_read_token": "${GITLAB_READ_TOKEN}"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://YOUR_ATLASSIAN_MCP_HOST/mcp/",
      "headers": {
        "confluence-read-token": "${CONFLUENCE_READ_TOKEN}",
        "jira-read-token": "${JIRA_READ_TOKEN}"
      }
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--figma-api-key=${FIGMA_API_KEY}", "--stdio"]
    }
  }
}
